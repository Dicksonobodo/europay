rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && (
          request.auth.token.get('admin', false) == true
          || (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
          )
        );
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validNewUser(uid) {
      return owns(uid)
        && request.resource.data.keys().hasOnly([
          'uid',
          'fullName',
          'email',
          'balance',
          'tier',
          'isPro',
          'withdrawalStage',
          'role',
          'cardNumber',
          'iban',
          'emailVerified',
          'isFrozen',
          'isSuspended',
          'dailyLimit',
          'preferredCurrency',
          'createdAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.balance == 0
        && request.resource.data.tier == 1
        && request.resource.data.isPro == false
        && request.resource.data.withdrawalStage == 'upgrade'
        && request.resource.data.role == 'user'
        && request.resource.data.isFrozen == false
        && request.resource.data.isSuspended == false
        && request.resource.data.dailyLimit is number
        && request.resource.data.dailyLimit > 0
        && request.resource.data.preferredCurrency in [
          'EUR', 'USD', 'GBP', 'NGN', 'GHS', 'KES', 'ZAR', 'CAD', 'AUD', 'JPY', 'CHF'
        ]
        && request.resource.data.createdAt == request.time;
    }

    function validSelfProfileUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['photoURL', 'dailyLimit', 'preferredCurrency'])
        && (!changed.hasAny(['photoURL'])
          || (request.resource.data.photoURL is string
            && request.resource.data.photoURL.size() <= 2048))
        && (!changed.hasAny(['dailyLimit'])
          || (request.resource.data.dailyLimit is number
            && request.resource.data.dailyLimit > 0
            && request.resource.data.dailyLimit <= 100000))
        && (!changed.hasAny(['preferredCurrency'])
          || request.resource.data.preferredCurrency in [
            'EUR', 'USD', 'GBP', 'NGN', 'GHS', 'KES', 'ZAR', 'CAD', 'AUD', 'JPY', 'CHF'
          ]);
    }

    function withdrawalMinimumMinor() {
      return exists(/databases/$(database)/documents/appSettings/defaults)
        ? get(/databases/$(database)/documents/appSettings/defaults).data.minimumWithdrawalMinor
        : 1000;
    }

    function withdrawalRequirementIsComplete(user) {
      let requirement = user.get('withdrawalRequirement', {});
      return !('step' in requirement)
        || requirement.step == 'none'
        || requirement.status == 'completed';
    }

    function validWithdrawalShape(uid, withdrawalId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'amountMinor',
          'currency',
          'method',
          'destination',
          'beneficiary',
          'cardBrand',
          'cardLast4',
          'cardExpiry',
          'bankName',
          'country',
          'accountLast4',
          'routingCodeLast4',
          'swift',
          'transactionId',
          'status',
          'processingMode',
          'createdAt'
        ])
        && data.amountMinor is int
        && data.amountMinor >= withdrawalMinimumMinor()
        && data.currency == 'EUR'
        && data.method in ['bitcoin', 'card', 'bank', 'wire']
        && data.destination is string
        && data.destination.size() > 0
        && data.destination.size() <= 200
        && data.beneficiary is string
        && data.beneficiary.size() <= 200
        && data.transactionId is string
        && data.transactionId.size() > 0
        && data.status == 'manual_review'
        && data.processingMode == 'simulated_manual'
        && data.createdAt == request.time
        && (data.method != 'card'
          || (data.cardBrand is string
            && data.cardBrand.size() <= 40
            && data.cardLast4 is string
            && data.cardLast4.matches('^[0-9]{4}$')
            && data.cardExpiry is string
            && data.cardExpiry.matches('^(0[1-9]|1[0-2])/[0-9]{2}$')))
        && (data.method != 'bank'
          || (data.bankName is string
            && data.bankName.size() > 0
            && data.bankName.size() <= 100
            && data.country is string
            && data.country.size() > 0
            && data.country.size() <= 100
            && data.accountLast4 is string
            && data.accountLast4.matches('^[A-Za-z0-9]{1,4}$')
            && (!data.keys().hasAny(['swift'])
              || data.swift.matches('^[A-Za-z]{4}[A-Za-z]{2}[A-Za-z0-9]{2}([A-Za-z0-9]{3})?$'))))
        && (data.method != 'wire'
          || (data.accountLast4 is string
            && data.accountLast4.matches('^[A-Za-z0-9]{1,4}$')
            && data.swift is string
            && data.swift.matches('^[A-Za-z]{4}[A-Za-z]{2}[A-Za-z0-9]{2}([A-Za-z0-9]{3})?$')
            && data.beneficiary.size() > 0));
    }

    function validWithdrawalPair(uid, withdrawalId) {
      let withdrawalPath = /databases/$(database)/documents/users/$(uid)/withdrawals/$(withdrawalId);
      let withdrawal = getAfter(withdrawalPath).data;
      let transactionPath = /databases/$(database)/documents/users/$(uid)/transactions/$(withdrawal.transactionId);
      let transactionData = getAfter(transactionPath).data;
      return existsAfter(withdrawalPath)
        && existsAfter(transactionPath)
        && withdrawal.transactionId is string
        && transactionData.withdrawalId == withdrawalId
        && transactionData.type == 'debit'
        && transactionData.description == 'Withdrawal request (manual review)'
        && transactionData.amount is number
        && transactionData.amount == withdrawal.amountMinor / 100
        && transactionData.status == 'manual_review'
        && transactionData.date == request.time;
    }

    function validWithdrawalBalanceUpdate(uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let withdrawalId = request.resource.data.lastWithdrawalId;
      let user = resource.data;
      let nextBalance = request.resource.data.balance;
      let balanceDifference = user.balance - nextBalance;
      return changed.hasOnly(['balance', 'lastWithdrawalId'])
        && withdrawalId is string
        && withdrawalId.size() > 0
        && withdrawalId != user.get('lastWithdrawalId', '')
        && user.balance is number
        && nextBalance is number
        && balanceDifference > 0
        && nextBalance >= 0
        && user.isPro == true
        && user.withdrawalStage == 'enabled'
        && user.tier == 2
        && withdrawalRequirementIsComplete(user)
        && user.isFrozen == false
        && user.isSuspended == false
        && validWithdrawalPair(uid, withdrawalId)
        && getAfter(
          /databases/$(database)/documents/users/$(uid)/withdrawals/$(withdrawalId)
        ).data.amountMinor == balanceDifference * 100;
    }

    function validWithdrawalCreate(uid, withdrawalId) {
      let userPath = /databases/$(database)/documents/users/$(uid);
      let user = get(userPath).data;
      return owns(uid)
        && validWithdrawalShape(uid, withdrawalId)
        && user.isPro == true
        && user.withdrawalStage == 'enabled'
        && user.tier == 2
        && withdrawalRequirementIsComplete(user)
        && user.isFrozen == false
        && user.isSuspended == false
        && validWithdrawalPair(uid, withdrawalId);
    }

    function validWithdrawalTransactionCreate(uid, transactionId) {
      let data = request.resource.data;
      let withdrawalPath = /databases/$(database)/documents/users/$(uid)/withdrawals/$(data.withdrawalId);
      let withdrawal = getAfter(withdrawalPath).data;
      return owns(uid)
        && data.keys().hasOnly([
          'type',
          'description',
          'amount',
          'withdrawalId',
          'status',
          'date'
        ])
        && data.type == 'debit'
        && data.description == 'Withdrawal request (manual review)'
        && data.amount is number
        && data.amount > 0
        && data.withdrawalId is string
        && data.status == 'manual_review'
        && data.date == request.time
        && existsAfter(withdrawalPath)
        && withdrawal.transactionId == transactionId
        && withdrawal.amountMinor == data.amount * 100
        && withdrawal.status == 'manual_review'
        && withdrawal.processingMode == 'simulated_manual';
    }

    match /users/{uid} {
      allow get: if owns(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if validNewUser(uid);
      allow update: if isAdmin()
        || (owns(uid) && validSelfProfileUpdate())
        || (owns(uid) && validWithdrawalBalanceUpdate(uid));
      allow delete: if isAdmin();

      match /transactions/{transactionId} {
        allow read: if owns(uid) || isAdmin();
        allow create: if isAdmin()
          || validWithdrawalTransactionCreate(uid, transactionId);
        allow update: if isAdmin()
          || (owns(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['date'])
            && request.resource.data.date is timestamp);
        allow delete: if isAdmin()
          || (owns(uid) && !('withdrawalId' in resource.data));
      }

      match /withdrawals/{withdrawalId} {
        allow read: if owns(uid) || isAdmin();
        allow create: if validWithdrawalCreate(uid, withdrawalId);
        allow update, delete: if isAdmin();
      }

      match /notifications/{notificationId} {
        allow read: if owns(uid) || isAdmin();
        allow create: if isAdmin();
        allow update: if isAdmin()
          || (owns(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
            && request.resource.data.read == true);
        allow delete: if owns(uid) || isAdmin();
      }

      match /loginActivity/{activityId} {
        allow read: if owns(uid) || isAdmin();
        allow create: if owns(uid)
          && request.resource.data.keys().hasOnly(['timestamp', 'userAgent', 'platform'])
          && request.resource.data.timestamp == request.time
          && request.resource.data.userAgent is string
          && request.resource.data.platform is string;
        allow update, delete: if isAdmin();
      }

      match /scheduledTransfers/{scheduleId} {
        allow read: if owns(uid) || isAdmin();
        allow create: if owns(uid)
          && request.resource.data.recipientUid is string
          && request.resource.data.recipientUid != uid
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.frequency in ['daily', 'weekly', 'monthly']
          && request.resource.data.status == 'active'
          && request.resource.data.createdAt == request.time;
        allow update: if isAdmin()
          || (owns(uid)
            && resource.data.status == 'active'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
        allow delete: if isAdmin();
      }

      match /budgets/{budgetId} {
        allow read: if owns(uid) || isAdmin();
        allow create, update: if isAdmin()
          || (owns(uid)
            && request.resource.data.category == budgetId
            && request.resource.data.amount is number
            && request.resource.data.amount >= 0);
        allow delete: if owns(uid) || isAdmin();
      }
    }

    match /appSettings/{settingId} {
      allow read: if signedIn();
      allow write: if isAdmin()
        && settingId == 'defaults'
        && request.resource.data.keys().hasOnly([
          'upgradePlanId',
          'minimumWithdrawalMinor',
          'updatedAt'
        ])
        && request.resource.data.upgradePlanId is string
        && request.resource.data.upgradePlanId.size() <= 100
        && request.resource.data.minimumWithdrawalMinor is int
        && request.resource.data.minimumWithdrawalMinor > 0
        && request.resource.data.updatedAt == request.time;
    }

    match /moneyRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid
          || isAdmin());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'fromUid',
          'fromName',
          'toUid',
          'amount',
          'note',
          'status',
          'createdAt'
        ])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.fromName is string
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();
    }

    match /splitBills/{billId} {
      allow read: if signedIn()
        && (resource.data.creatorUid == request.auth.uid
          || resource.data.participants.hasAny([
            {'uid': request.auth.uid}
          ])
          || isAdmin());
      allow create: if signedIn()
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.creatorName is string
        && request.resource.data.description is string
        && request.resource.data.totalAmount is number
        && request.resource.data.totalAmount > 0
        && request.resource.data.perPerson is number
        && request.resource.data.participants is list
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();
    }

    match /auditLog/{entryId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
